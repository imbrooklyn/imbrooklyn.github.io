---
import type { Book } from "../data/books";

interface Props {
  headingLevel?: 2 | 3;
  items: readonly Book[];
}

const { headingLevel = 2, items } = Astro.props;
---

<ol class="book-list">
  {
    items.map((book) => (
      <li class="book-item">
        <a class="book-item__primary" href={book.href}>
          <span class="book-item__topline">
            <span>Web book</span>
            <span class="book-item__status">{book.status}</span>
          </span>
          <span class="book-item__content">
            {headingLevel === 2 ? (
              <h2>{book.title}</h2>
            ) : (
              <h3>{book.title}</h3>
            )}
            <span class="book-item__title-zh" lang="zh-CN">
              {book.titleZh}
            </span>
            <span class="book-item__description">{book.description}</span>
          </span>
        </a>
        <span class="book-item__footer">
          <span class="book-item__languages" aria-label="Available languages">
            {book.languages.map((language, index) => (
              <>
                {index > 0 && <span aria-hidden="true"> · </span>}
                <a href={language.href} lang={language.lang}>{language.label}</a>
              </>
            ))}
          </span>
          <a class="book-item__destination" href={book.href}>Read →</a>
        </span>
      </li>
    ))
  }
</ol>
