---
const destination = import.meta.env.DEV
  ? "http://localhost:4322/books/understanding-llms/"
  : "/books/understanding-llms/en/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex" />
    <title>Opening the Book preview</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body>
    <p>
      Continue to the <a href={destination}>Book preview</a>.
    </p>
  </body>
</html>
