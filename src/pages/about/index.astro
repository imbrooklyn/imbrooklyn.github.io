---
import { focusAreas, siteConfig } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`About — ${siteConfig.name}`}
  description={siteConfig.description}
>
  <header class="page-intro page-intro--compact page-shell">
    <h1>About</h1>
    <p>
      I am Brooklyn Yu, a software engineer focused on developer tools,
      infrastructure, API design, and reliability.
    </p>
  </header>

  <section class="about-profile page-shell" aria-label="Professional background">
    <div class="about-profile__item">
      <p class="eyebrow">Experience</p>
      <h2>Developer platforms and infrastructure</h2>
      <ul class="about-profile__list">
        <li>
          Developer platforms for software delivery, including CI/CD systems,
          artifact workflows, and engineering lifecycle tooling.
        </li>
        <li>
          IT operations platforms for Microsoft Active Directory management,
          virtualization, and storage infrastructure.
        </li>
        <li>Kubernetes-based infrastructure and operational tooling.</li>
        <li>
          System architecture, modernization, performance, and reliability,
          with an emphasis on clear interfaces and maintainable operations.
        </li>
      </ul>
    </div>

    <div class="about-profile__item">
      <p class="eyebrow">Education</p>
      <h2>Computer science</h2>
      <p>
        I hold an MSc in Computer Science from the University of Birmingham,
        awarded with Distinction.
      </p>
    </div>
  </section>

  <section class="about-section page-shell" aria-labelledby="about-focus-title">
    <div class="section-heading">
      <p class="eyebrow">Areas of focus</p>
      <h2 id="about-focus-title">Technical interests</h2>
    </div>
    <ul class="focus-list" aria-label="Technical interests">
      {focusAreas.map((area) => <li>{area}</li>)}
    </ul>
  </section>

  <section class="about-links page-shell" aria-labelledby="about-links-title">
    <div>
      <p class="eyebrow">Elsewhere</p>
      <h2 id="about-links-title">Code and writing</h2>
    </div>
    <div class="link-group">
      <a class="button button--primary" href={siteConfig.githubUrl}>GitHub</a>
      <a class="button" href="/blog/">Read the blog</a>
    </div>
  </section>
</BaseLayout>
